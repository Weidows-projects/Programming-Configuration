{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "╭─",
          "foreground": "#2eaa2c",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_separator_icon": "/",
            "style": "full"
          },
          "trailing_diamond": "<#ff70a6></><#00c7fc></>",
          "template": " 🤣 {{ .Path }}  ",
          "foreground": "#2eaa2c",
          "background": "#242424",
          "type": "path",
          "style": "diamond"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "⌛ {{ .FormattedMs }} {{ if gt .Code 0 }}{{ else }}{{ end }} ",
          "foreground": "#21c7c7",
          "powerline_symbol": "",
          "background": "#242424",
          "type": "executiontime",
          "style": "powerline",
          "foreground_templates": ["{{ if gt .Code 0 }}#f1184c{{ end }}"]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "trailing_diamond": "",
          "template": "",
          "foreground": "#21c7c7",
          "type": "text",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "context"
          },
          "leading_diamond": " ",
          "trailing_diamond": "",
          "template": " {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}",
          "foreground": "#3A86FF",
          "background": "#242424",
          "type": "python",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": " ",
          "trailing_diamond": "",
          "template": " {{ .Full }}",
          "foreground": "#ffffff",
          "background": "#6CA35E",
          "type": "node",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_upstream_icon": true
          },
          "leading_diamond": " ",
          "trailing_diamond": "",
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "foreground": "#fff",
          "background": "lightCyan",
          "type": "git",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "15:04:05"
          },
          "leading_diamond": " ",
          "trailing_diamond": " ",
          "template": "⏰ {{ .CurrentDate | date .Format }}",
          "foreground": "#d6deeb",
          "background": "lightMagenta",
          "type": "time",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "trailing_diamond": "",
          "template": "╰─",
          "foreground": "#2eaa2c",
          "type": "text",
          "style": "diamond"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": " 👉",
          "foreground": "#2eaa2c",
          "trailing_diamond": "",
          "background": "#242424",
          "type": "text",
          "style": "diamond",
          "background_templates": ["{{ if gt .Code 0 }}#f1184c{{ end }}"]
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
